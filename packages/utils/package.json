{
  "name": "@mlaursen/utils",
  "version": "0.2.0",
  "description": "A package of utils I generally find myself using in projects",
  "keywords": [
    "PascalCase",
    "camelCase",
    "kebab-case",
    "upperFirst",
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/mlaursen/npm-packages/issues"
  },
  "license": "MIT",
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaursen/npm-packages.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean-dist": "rm -rf dist",
    "clean-cache": "rm -rf .turbo  node_modules",
    "clean": "concurrently 'pnpm clean-dist' 'pnpm clean-cache'",
    "format": "oxfmt",
    "check-format": "pnpm format --check",
    "lint": "eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "tsc --noEmit --watch",
    "build-dist": "rollup -c rollup.config.ts",
    "build-dist-watch": "pnpm build-dist --watch",
    "build-types": "tsc -p tsconfig.types.json",
    "build-types-watch": "pnpm build-types --watch",
    "generate-simple-docs": "simple-docs",
    "build": "pnpm build-types && pnpm build-dist",
    "test": "vitest",
    "test-coverage": "vitest --coverage",
    "test-run": "vitest run",
    "test-run-snapshot": "vitest run -u",
    "test-run-coverage": "vitest run --coverage",
    "dev": "concurrently 'pnpm build-types-watch' 'pnpm build-dist-watch'"
  },
  "devDependencies": {
    "@mlaursen/eslint-config": "workspace:*",
    "@mlaursen/simple-docs": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "oxfmt": "^0.63.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
