{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build-dist": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "!src/**/*-styles.ts", "rollup.config.ts"],
      "outputs": [
        "dist/index.js",
        "dist/define.js",
        "dist/*/define.js",
        "dist/*.d.ts",
        "src/**/*-styles.ts"
      ]
    },
    "build-default-css": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.scss"],
      "outputs": ["dist/*.css", "src/*.min.css"]
    },
    "build-scss": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.scss"],
      "outputs": ["dist/**/*.scss"]
    },
    "build": {
      "dependsOn": ["build-dist", "build-default-css", "build-scss"],
      "outputs": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.scss",
        "dist/*.css",
        "dist/*.min.css",
        "src/**/*-styles.ts"
      ]
    },
    "start": {
      "dependsOn": ["build"]
    }
  }
}
