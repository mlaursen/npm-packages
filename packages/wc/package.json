{
  "name": "@mlaursen/wc",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "exports": {
    ".": {
      "sass": "./dist/_index.scss",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "node-run": "node --experimental-strip-types",
    "clean-dist": "rm -rf dist",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "concurrently 'pnpm clean-dist' 'pnpm clean-cache'",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint": "eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "tsc --noEmit --watch",
    "build-scss": "mlaursen-cli copy-scss-files \"src/**/_*.scss\"",
    "build-scss-watch": "pnpm build-scss --watch",
    "build-esm": "swc -d ./dist --strip-leading-paths src",
    "build-esm-watch": "pnpm build-esm --watch",
    "build-rollup": "rollup -c rollup.config.ts",
    "build-rollup-watch": "pnpm build-dist --watch",
    "build-dist": "pnpm build-esm && pnpm build-rollup",
    "build-dist-watch": "concurrently 'pnpm build-esm-watch' 'pnpm build-rollup-watch'",
    "build-types": "tsc -p tsconfig.types.json",
    "build-types-watch": "pnpm build-types --watch",
    "build-watch": "concurrently 'pnpm build-esm-watch' 'pnpm build-rollup-watch' 'pnpm build-scss-watch'",
    "dev": "concurrently 'pnpm build-types-watch' 'pnpm build-esm-watch' 'pnpm build-rollup-watch'"
  },
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaursen/npm-packages.git",
    "directory": "packages/wc"
  },
  "bugs": {
    "url": "https://github.com/mlaursen/npm-packages/issues"
  },
  "keywords": [
    "ui",
    "web components",
    "lit"
  ],
  "license": "MIT",
  "dependencies": {
    "@open-wc/form-control": "^1.0.0",
    "@open-wc/lit-helpers": "^0.7.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@mlaursen/cli": "workspace:*",
    "@mlaursen/eslint-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.12.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "glob": "^13.0.6",
    "prettier": "^3.8.3",
    "rollup": "^4.60.4",
    "rollup-plugin-summary": "^3.0.1",
    "rollup-plugin-swc3": "^0.12.1",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
