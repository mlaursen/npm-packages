{
  "name": "@mlaursen/wc",
  "version": "0.0.2",
  "description": "",
  "keywords": [
    "lit",
    "ui",
    "web components"
  ],
  "bugs": {
    "url": "https://github.com/mlaursen/npm-packages/issues"
  },
  "license": "MIT",
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaursen/npm-packages.git",
    "directory": "packages/wc"
  },
  "type": "module",
  "exports": {
    ".": {
      "sass": "./dist/_index.scss",
      "default": "./dist/index.js"
    },
    "./compile-styles": "./dist/compile-styles.js",
    "./compile-styles-esbuild-plugin": "./dist/compile-styles-esbuild-plugin.js",
    "./compile-styles-rollup-plugin": "./dist/compile-styles-rollup-plugin.js",
    "./define": "./dist/define.js",
    "./*/define": "./dist/*/define.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "node-run": "node --experimental-strip-types",
    "convert-material-theme": "pnpm node-run scripts/convert-material-theme.ts",
    "test-clean-generated": "git clean -ndX src",
    "clean-generated": "git clean -fdXq src",
    "clean-dist": "rm -rf dist types",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "pnpm clean-dist; pnpm clean-cache; pnpm clean-generated",
    "format": "oxfmt",
    "check-format": "pnpm format --check",
    "lint": "oxlint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "tsc --noEmit --watch",
    "bootstrap": "pnpm node-run scripts/bootstrap.ts",
    "test-scss": "pnpm node-run scripts/test-scss.ts",
    "test": "vitest",
    "test-coverage": "vitest --coverage",
    "test-run": "vitest run",
    "test-run-snapshot": "vitest run -u",
    "test-run-coverage": "vitest run --coverage",
    "build-default-css": "pnpm node-run scripts/build-default-css.ts",
    "build-scss": "mlaursen-cli copy-scss-files \"src/**/_*.scss\"",
    "build-scss-watch": "pnpm build-scss -w",
    "build-rollup": "rollup -c rollup.config.ts --configPlugin rollup-plugin-swc3",
    "build-rollup-watch": "pnpm build-rollup --watch",
    "build-types": "tsc -P tsconfig.types.json",
    "build-types-watch": "pnpm build-types --watch",
    "build-components": "tsx scripts/generate-components/index.ts",
    "build-components-watch": "pnpm build-components --watch",
    "build-dist": "concurrently 'pnpm build-scss' 'pnpm build-rollup'",
    "build-dist-watch": "concurrently 'pnpm build-scss-watch' 'pnpm build-rollup-watch'",
    "dev": "pnpm build-dist-watch"
  },
  "dependencies": {
    "@mlaursen/utils": "workspace:*",
    "@open-wc/lit-helpers": "^0.7.0",
    "lit": "^3.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@mlaursen/cli": "workspace:*",
    "@mlaursen/node-utils": "workspace:*",
    "@mlaursen/oxlint-config": "workspace:*",
    "@mlaursen/scss": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.6",
    "css-declaration-sorter": "^7.4.0",
    "esbuild": "^0.28.2",
    "glob": "^14.0.3",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.32.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "rollup": "^4.67.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-summary": "^3.0.1",
    "rollup-plugin-swc3": "^0.12.1",
    "sass-embedded": "^1.107.1",
    "ts-lit-plugin": "^2.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@mlaursen/node-utils": "workspace:*",
    "@mlaursen/scss": "workspace:*",
    "css-declaration-sorter": "^7.4.0",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.32",
    "sass-embedded": "^1.107.1"
  },
  "peerDependenciesMeta": {
    "@mlaursen/node-utils": {
      "optional": true
    },
    "@mlaursen/scss": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "css-declaration-sorter": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    }
  }
}
