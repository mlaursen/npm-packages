{
  "name": "@mlaursen/cli",
  "version": "1.1.2",
  "description": "A small util to copy SCSS files for publishing.",
  "bin": {
    "mlaursen-cli": "./cli.js"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean-dist": "rm -rf dist types",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "pnpm clean-dist; pnpm clean-cache",
    "check-format": "pnpm format --check",
    "format": "oxfmt",
    "lint": "oxlint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "pnpm typecheck --watch",
    "build-dist": "rollup -c rollup.config.ts",
    "build-dist-watch": "pnpm build-dist --watch",
    "build": "pnpm build-dist",
    "dev": "pnpm build-dist-watch"
  },
  "dependencies": {
    "@mlaursen/copy-scss-files": "workspace:*",
    "@mlaursen/node-utils": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@mlaursen/oxlint-config": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.13.2",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rollup": "^4.63.3",
    "rollup-plugin-swc3": "^0.12.1",
    "typescript": "^6.0.3"
  }
}
