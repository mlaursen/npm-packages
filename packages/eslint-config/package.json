{
  "name": "@mlaursen/eslint-config",
  "version": "12.0.12",
  "description": "An eslint config used by mlaursen for most projects.",
  "keywords": [
    "eslint",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/mlaursen/npm-packages/issues"
  },
  "license": "MIT",
  "author": "Mikkel Laursen <mlaursen03@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaursen/npm-packages.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean-dist": "rm -rf dist types",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "concurrently 'pnpm clean-dist' 'pnpm clean-cache'",
    "check-format": "pnpm format --check",
    "format": "oxfmt",
    "lint": "eslint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "pnpm typecheck --watch",
    "build-dist": "rollup -c rollup.config.ts",
    "build-dist-watch": "pnpm build-dist --watch",
    "build-types": "tsc -p tsconfig.types.json",
    "build-types-watch": "pnpm build-types --watch",
    "build": "pnpm build-types && pnpm build-dist",
    "dev": "concurrently 'pnpm build-types-watch' 'pnpm build-dist-watch'"
  },
  "dependencies": {
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^9.39.4",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@typescript-eslint/utils": "^8.66.0",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^9.39.4",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "typescript-eslint": "^8.66.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^24.13.2",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.63.0",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-swc3": "^0.12.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">= 9.0.0",
    "typescript": ">= 5"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  }
}
