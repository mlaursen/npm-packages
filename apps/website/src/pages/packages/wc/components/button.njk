---
layout: docs
permalink: /packages/wc/components/button.html
doc:
  title: Button

sizes:
  # - "extra-small"
  - "small"
  # - "medium"
  # - "large"
  # - "extra-large"

variants:
  - "tonal"
  - "text"
  - "outlined"
  - "filled"
  - "elevated"

shapes:
  - "round"
  - "square"

disabled:
  - false
  - true

icons:
  - leading: false
    trailing: false
  - leading: true
    trailing: false
  - leading: false
    trailing: true
---

<mwc-text-container>
<mwc-typography variant="headline">
<h2>Buttons</h2>
</mwc-typography>
{% for variant in variants %}
  {% for isDisabled in disabled %}
    {% for shape in shapes %}
      <mwc-typography variant="title" text-transform="capitalize">
      <h3>
        {{ variant }} {{ shape }}
        {% if isDisabled %}(disabled){% endif %}
      </h3>
      </mwc-typography>
      <mwc-box>
      {% for icon in icons %}
        {% for size in sizes %}
          <mwc-button size="{{ size }}" variant="{{ variant }}" shape="{{ shape }}"
          {% if isDisabled %}disabled{% endif %}
          >
          {% if icon.leading %}
            <mwc-material-symbol>favorite</mwc-material-symbol>
          {% endif %}
          Label
          {% if icon.trailing %}
            <mwc-material-symbol>favorite</mwc-material-symbol>
          {% endif %}
          </mwc-button>
          {% set dividerVariant %}
            {{ "inset" if icon.leading else "middle" }}
          {% endset %}
          <mwc-divider variant={{ dividerVariant }} aria-orientation="vertical"></mwc-divider>
        {% endfor %}
      {% endfor %}
      </mwc-box>
    {% endfor %}
  {% endfor %}
  <mwc-divider></mwc-divider>
{% endfor %}
</mwc-text-container>
