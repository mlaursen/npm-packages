{% set metaDescription %}
  {{- description or data.description or meta.description -}}
{% endset %}
<meta name="description" content="{{ metaDescription }}" />
<!-- search engines -->
<meta name="robots" content="index,follow" />
<meta name="googlebot" content="index,follow" />
<!-- Disable automatic detection and formatting of possible phone numbers -->
<meta name="format-detection" content="telephone=no" />
<!-- supports both dark and light color schemes, page author prefers light as default. -->
<meta name="color-scheme" content={{ colorScheme or meta.colorScheme }} />
<!-- Helps prevent duplicate content issues -->
<link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
<!-- Open Graph meta  -->
<meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
<meta property="og:type" content="website" />
<meta property="og:title" content="{{ title or data.title or meta.title }}" />
{% set ogImageUrl %}
  {%- if og.image -%}
    {{- og.image -}}
  {%- else -%}
    {{- meta.og.image -}}
  {%- endif -%}
{% endset %}
{% set ogImageAlt %}
  {%- if og.alt -%}
    {{- og.alt -}}
  {%- else -%}
    {{- meta.og.alt -}}
  {%- endif -%}
{% endset %}
<meta property="og:image" content="{{ ogImageUrl }}" />
{% if ogImageAlt %}
  <meta property="og:image"
        content="{%- if data.og.url -%} {{- meta.url -}}/assets/og-images/{{ title | slugify }}-preview.png {%- else -%} {{- meta.url -}}{{- meta.og.image -}} {%- endif -%}" />
{% endif %}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:description" content="{{ metaDescription }}" />
<meta property="og:site_name" content="{{ meta.siteName }}" />
<meta property="og:locale" content="{{ meta.locale }}" />
<meta property="article:author" content="{{ meta.author.name }}" />
<!-- Favicon: https://evilmartians.com/chronicles/how-to-favicon-in-2021-six-files-that-fit-most-needs -->
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="any" />
<link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml" />
<link rel="apple-touch-icon"
      sizes="180x180"
      href="{{ '/apple-touch-icon.png' | url }}" />
<link rel="manifest" href="{{ '/site.webmanifest' | url }}" />
