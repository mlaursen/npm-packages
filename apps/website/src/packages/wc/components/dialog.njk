---
layout: docs
eleventyNavigation:
  key: Dialog
  parent: Home

page:
  title: Dialog
---

<mwc-box stacked align="stretch">
  <mwc-box padding="none">
    <mwc-button command="show-modal" commandfor="dialog-1">
      Show Simple
    </mwc-button>
    <mwc-button command="show-modal" commandfor="dialog-2">
      Show Alert
    </mwc-button>
    <mwc-button command="show-modal" commandfor="dialog-3">
      Show Icon
    </mwc-button>
  </mwc-box>
  <mwc-dialog id="dialog-1">
    <h2 slot="title">Title</h2>
    <p slot="content">Hello, world!</p>
    <mwc-text-button slot="actions" command="close" commandfor="dialog-1">
      Cancel
    </mwc-text-button>
    <mwc-text-button slot="actions" command="close" commandfor="dialog-1" autofocus>
      Ok
    </mwc-text-button>
  </mwc-dialog>
  <mwc-dialog id="dialog-2" type="alert">
    <h2 slot="title">Alert dialog</h2>
    <p slot="content">
      This is a description of the alert. The alertdialog role is used to notify users of urgent information that demands the user's immediate attention.
    </p>
    <mwc-text-button slot="actions" command="close" commandfor="dialog-2">
      Ok
    </mwc-text-button>
  </mwc-dialog>
  <mwc-dialog id="dialog-3" width="small">
    <mwc-material-symbol slot="icon">
      delete
    </mwc-material-symbol>
    <h2 slot="title">Permanently delete?</h2>
    <p slot="content">
      Deleting the selected photos will also remove them from all synced devices.
    </p>
    <mwc-text-button slot="actions" command="close" commandfor="dialog-3">
      Delete
    </mwc-text-button>
    <mwc-tonal-button slot="actions" command="close" commandfor="dialog-3" autofocus>
      Cancel
    </mwc-tonal-button>
  </mwc-dialog>
  <mwc-dialog popover-initiator="no-click">
    <mwc-button slot="popover-target">
      Show Popover
    </mwc-button>
    <p slot="content">This is the main content!</p>
  </mwc-dialog>
  <mwc-button command="show-modal" commandfor="dialog-5">
    Show Form Dialog
  </mwc-button>
  <mwc-dialog id="dialog-5">
    <h2 slot="title">Title</h2>
    <form id="form" slot="content" method="dialog">
      <input type="text" name="firstName" defaultValue="John" />
      <input type="text" name="lastName" defaultValue="Doe" />
    </form>
    <mwc-button slot="actions" form="form" value="close">
      Cancel
    </mwc-button>
    <mwc-button slot="actions" form="form" value="ok">
      OK
    </mwc-button>
  </mwc-dialog>
