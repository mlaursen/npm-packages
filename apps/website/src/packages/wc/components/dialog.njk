---
layout: docs
eleventyNavigation:
  key: Dialog
  parent: Home

page:
  title: Dialog
---

<mwc-box stacked align="start">
  <mwc-typography variant="headline">
    <h2>Command API</h2>
  </mwc-typography>
  <mwc-button command="show-modal" commandfor="command-dialog-1">
    Show Modal
  </mwc-button>
  <mwc-dialog id="command-dialog-1">
    <h2 slot="title">Title</h2>
    <p>Hello, world!</p>
    <mwc-button slot="actions"
                variant="text"
                command="close"
                commandfor="command-dialog-1">
      Cancel
    </mwc-button>
    <mwc-button slot="actions"
                variant="text"
                command="close"
                commandfor="command-dialog-1"
                autofocus>
      Ok
    </mwc-button>
  </mwc-dialog>
  <mwc-button command="show-modal" commandfor="command-dialog-2">
    Show Alert
  </mwc-button>
  <mwc-dialog id="command-dialog-2" type="alert">
    <h2 slot="title">Alert dialog</h2>
    <p>
      This is a description of the alert. The alertdialog role is used to notify users of urgent information that demands the user's immediate attention.
    </p>
    <mwc-button slot="actions"
                variant="text"
                command="close"
                commandfor="command-dialog-2">
      Ok
    </mwc-button>
  </mwc-dialog>
  <mwc-button command="show-modal" commandfor="command-dialog-3">
    Show Icon Modal
  </mwc-button>
  <mwc-dialog id="command-dialog-3" width="small">
    <mwc-material-symbol slot="icon">
      delete
    </mwc-material-symbol>
    <h2 slot="title">Permanently delete?</h2>
    <p>
      Deleting the selected photos will also remove them from all synced devices.
    </p>
    <mwc-button slot="actions"
                variant="text"
                command="close"
                commandfor="command-dialog-3">
      Delete
    </mwc-button>
    <mwc-button slot="actions"
                variant="tonal"
                command="close"
                commandfor="command-dialog-3"
                autofocus>
      Cancel
    </mwc-button>
  </mwc-dialog>
  <mwc-divider>
  </mwc-divider>
  <mwc-typography variant="headline">
    <h2>Form API</h2>
  </mwc-typography>
  <mwc-button command="show-modal"
              commandfor="form-dialog-1"
              onclick="document.querySelector('#form-dialog-1-form').reset()">
    Show Modal
  </mwc-button>
  <mwc-dialog id="form-dialog-1">
    <h2 slot="title">Form Example</h2>
    <form id="form-dialog-1-form"  method="dialog">
      <mwc-text-field name="animal" required>
        <span slot="label">Favorite animal</span>
      </mwc-text-field>
    </form>
    <mwc-button slot="actions"
                form="form-dialog-1-form"
                type="submit"
                variant="text">
      Normal Close
    </mwc-button>
    <mwc-button slot="actions"
                form="form-dialog-1-form"
                type="submit"
                variant="outlined"
                formnovalidate>
      Novalidate Close
    </mwc-button>
    <mwc-button slot="actions"
                variant="tonal"
                onclick="document.querySelector('#form-dialog-1').close()">
      JS Close
    </mwc-button>
  </mwc-dialog>
  <mwc-divider>
  </mwc-divider>
  <mwc-typography variant="headline">
    <h2>Cancelable API</h2>
  </mwc-typography>
  <mwc-box>
    <mwc-button id="cancelable-dialog-button">
      Show Dialog
    </mwc-button>
    <mwc-typography>
      <label>
        <mwc-box padding="none">
          <mwc-checkbox id="cancelable-dialog-request-close"
                        name="requestClose">
          </mwc-checkbox>
          <span>Use <code>dialog.requestClose()</code></span>
        </mwc-box>
      </label>
    </mwc-typography>
  </mwc-box>
  <pre style="height: 20rem;
              overflow: auto;
              width: 100%"><ol id="cancelable-dialog-logs"></ol></pre>
  <mwc-box justify="end">
    <mwc-button id="clear-cancelable-dialog-logs">
      Clear Logs
    </mwc-button>
  </mwc-box>
  <mwc-dialog id="cancelable-dialog">
    <h2 slot="title">Cancelable Dialog</h2>
    <mwc-typography>
      <p id="cancelable-dialog-close-message">
        If the checkbox is checked, clicking the next two buttons will still
        close the dialog since <code>dialog.close()</code> is called. Pressing
        the <kbd>Escape</kbd> key or clicking the backdrop will not close the dialog.
      </p>
      <p id="cancelable-dialog-request-close-message" hidden>
        If the checkbox is checked, clicking the next two buttons, the backdrop,
        or pressing the <kbd>Escape</kbd> key will not close the dialog.
      </p>
    </mwc-typography>
    <mwc-typography variant="label">
      <label>
        <mwc-box padding="none" inline>
          <mwc-checkbox id="force-cancel-close-checkbox" name="cancel">
          </mwc-checkbox>
          Cancel close
        </mwc-box>
      </label>
    </mwc-typography>
    <mwc-button variant="text" slot="actions">
      Close
    </mwc-button>
    <mwc-button variant="tonal" slot="actions">
      Close with value
    </mwc-button>
  </mwc-dialog>
  <mwc-divider>
  </mwc-divider>
  <mwc-typography variant="headline">
    <h2>Popover API</h2>
  </mwc-typography>
  <mwc-dialog popover-type="hint" popover-initiator="all">
    <mwc-button slot="popover-target">
      Show Dialog
    </mwc-button>
    <h2 slot="title">Hello, world!</h2>
    <p>Here is some text content.</p>
  </mwc-dialog>
  <mwc-typography variant="headline">
    <h2>Fixed Dialog</h2>
  </mwc-typography>
  <mwc-button id="show-fixed-1"
              onclick="document.querySelector('#fixed-dialog-1').show()">
    Show
  </mwc-button>
  <mwc-dialog id="fixed-dialog-1" type="fixed">
    <h2 slot="title">Fixed Dialog Title</h2>
    <p>Fixed dialogs were mostly added to support "inline" sheets.</p>
    <mwc-button slot="actions"
                variant="text"
                command="close"
                commandfor="fixed-dialog-1">
      Delete
    </mwc-button>
    <mwc-button slot="actions"
                variant="tonal"
                command="close"
                commandfor="fixed-dialog-1"
                autofocus>
      Cancel
    </mwc-button>
  </mwc-dialog>
  <div style="height: 40rem"></div>
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/dialog.js" %}
{% endjs %}
