---
layout: docs
eleventyNavigation:
  key: Sheet
  parent: Home

page:
  title: Sheet
---

<mwc-box stacked align="start">
  <mwc-button id="show-sheet-1">
    Show Sheet
  </mwc-button>
  <mwc-sheet id="sheet-1" close-button>
    <h1 slot="title">Headline</h1>
    <p>Hello, world!</p>
    <mwc-box stacked align="start" padding="block">
      <mwc-button id="toggle-position">
        Toggle Position
      </mwc-button>
      <mwc-button id="toggle-variant">
        Toggle Variant
      </mwc-button>
      <mwc-button id="toggle-shape">
        Toggle Shape
      </mwc-button>
      <dl>
        <dt>position</dt>
        <dd id="position">
          {{ sheet.positions[0] }}
        </dd>
        <dt>variant</dt>
        <dd id="variant">
          {{ sheet.variants[0] }}
        </dd>
        <dt>shape</dt>
        <dd id="shape">
          {{ sheet.shapes[0] }}
        </dd>
      </dl>
    </mwc-box>
  </mwc-sheet>
  <mwc-button command="show-modal" commandfor="sheet-2">
    Show Simple
  </mwc-button>
  <mwc-sheet id="sheet-2" back-button close-button>
    <h1 slot="title">Headline</h1>
    <p>Hello, world!</p>
  </mwc-sheet>
  <mwc-button command="show-modal" commandfor="sheet-3">
    Show Title
  </mwc-button>
  <mwc-sheet id="sheet-3">
    <h1 slot="title">Headline</h1>
    <p>Hello, world!</p>
    <mwc-material-symbol slot="back-icon">
      favorite
    </mwc-material-symbol>
  </mwc-sheet>
  <mwc-divider>
  </mwc-divider>
  <mwc-typography variant="headline">
    <h2>Inline With Content</h2>
  </mwc-typography>
  <mwc-button onclick="document.querySelector('#fixed-sheet').show()">
    Show
  </mwc-button>
  <mwc-sheet id="fixed-sheet"
             type="fixed"
             position="left"
             close-button
             back-button>
    <h1 slot="title">Headline</h1>
    <p>Hello, world!</p>
  </mwc-sheet>
  <div style="height: 80rem"></div>
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/sheet.js" %}
{% endjs %}
