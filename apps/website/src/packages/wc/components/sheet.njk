---
layout: docs
eleventyNavigation:
  key: Sheet
  parent: Home

page:
  title: Sheet
---

<mwc-box stacked align="start">
  <mwc-button id="show-sheet-1">
    Show Sheet
  </mwc-button>
  <mwc-sheet id="sheet-1" close-button>
    <h1 slot="title">Headline</h1>
    <p slot="content">Hello, world!</p>
    <mwc-box disable-padding stacked align="start">
      <mwc-button id="toggle-position">
        Toggle Position
      </mwc-button>
      <mwc-button id="toggle-variant">
        Toggle Variant
      </mwc-button>
      <mwc-button id="toggle-shape">
        Toggle Shape
      </mwc-button>
      <dl>
        <dt>position</dt>
        <dd id="position">
          {{ sheet.positions[0] }}
        </dd>
        <dt>variant</dt>
        <dd id="variant">
          {{ sheet.variants[0] }}
        </dd>
        <dt>shape</dt>
        <dd id="shape">
          {{ sheet.shapes[0] }}
        </dd>
      </dl>
    </mwc-box>
  </mwc-sheet>
  <mwc-button command="show-modal" commandfor="sheet-2">
    Show Simple
  </mwc-button>
  <mwc-sheet id="sheet-2" back-button close-button>
    <h1 slot="title">Headline</h1>
    <p slot="content">Hello, world!</p>
  </mwc-sheet>
  <mwc-button command="show-modal" commandfor="sheet-3">
    Show Title
  </mwc-button>
  <mwc-sheet id="sheet-3">
    <h1 slot="title">Headline</h1>
    <p slot="content">Hello, world!</p>
    <mwc-material-symbol slot="back-icon">
      favorite
    </mwc-material-symbol>
  </mwc-sheet>
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/sheet.js" %}
{% endjs %}
