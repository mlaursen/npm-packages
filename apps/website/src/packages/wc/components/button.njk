---
layout: docs

eleventyNavigation:
  key: Button
  parent: Home

page:
  title: Button

disabled:
  - false
  - true

icons:
  - leading: false
    trailing: false
  - leading: true
    trailing: false
  - leading: false
    trailing: true
---

<mwc-text-container>
  <mwc-box grid="2">
    {% for variant in button.variants %}
      {% for isDisabled in disabled %}
        <div>
          <mwc-button variant="{{ variant }}" {{ "disabled" if isDisabled }}>
            <mwc-material-symbol>
              favorite
            </mwc-material-symbol>
            {{ variant | capitalize }}
          </mwc-button>
        </div>
      {% endfor %}
    {% endfor %}
  </mwc-box>
  <mwc-typography variant="headline">
    <h2>Buttons</h2>
  </mwc-typography>
  {% for variant in button.variants %}
    {% for isDisabled in disabled %}
      {% for shape in button.shapes %}
        <mwc-typography variant="title" text-transform="capitalize">
          <h3>
            {{ variant }} {{ shape }}
            {% if isDisabled %}(disabled){% endif %}
          </h3>
        </mwc-typography>
        <mwc-box>
          {% for icon in icons %}
            {% for size in button.sizes %}
              <mwc-button size="{{ size }}"
                          variant="{{ variant }}"
                          shape="{{ shape }}"
                          {% if isDisabled %}disabled{% endif %}>
                {% if icon.leading %}
                  <mwc-material-symbol>
                    favorite
                  </mwc-material-symbol>
                {% endif %}
                Label
                {% if icon.trailing %}
                  <mwc-material-symbol>
                    favorite
                  </mwc-material-symbol>
                {% endif %}
              </mwc-button>
            {% endfor %}
          {% endfor %}
        </mwc-box>
      {% endfor %}
    {% endfor %}
  {% endfor %}
</mwc-text-container>
