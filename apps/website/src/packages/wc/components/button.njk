---
layout: docs

eleventyNavigation:
  key: Button
  parent: Home

page:
  title: Button

disabled:
  - false
  - true

icons:
  - leading: false
    trailing: false
  - leading: true
    trailing: false
  - leading: false
    trailing: true
---

<mwc-box grid="2">
  {% for variant in button.variants %}
    {% for isDisabled in disabled %}
      <div>
        <mwc-button variant="{{ variant }}" {{ "disabled" if isDisabled }}>
          <mwc-material-symbol>
            favorite
          </mwc-material-symbol>
          {{ variant | capitalize }}
        </mwc-button>
      </div>
    {% endfor %}
  {% endfor %}
</mwc-box>
<mwc-divider>
</mwc-divider>
<mwc-box grid="4">
  <mwc-typography>
    Unselected
  </mwc-typography>
  <mwc-typography>
    Selected
  </mwc-typography>
  <mwc-typography>
    Unselected (Disabled)
  </mwc-typography>
  <mwc-typography>
    Selected (Disabled)
  </mwc-typography>
  {% for variant in button.variants %}
    {% if variant != "text" %}
      {% for isDisabled in disabled %}
        {% for state in button.states %}
          {% if state != "normal" %}
            <div>
              {% set pressed = state == "selected" %}
              <mwc-button aria-pressed="{{ pressed }}"
                          variant="{{ variant }}"
                          {{ "disabled" if isDisabled }}>
                <mwc-material-symbol>
                  favorite
                </mwc-material-symbol>
                {{ variant | capitalize }}
              </mwc-button>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      <mwc-typography style="grid-column: 1 / -1" color="error">
        <p>{{ variant |capitalize }} buttons do not support selected states.</p>
      </mwc-typography>
    {% endif %}
  {% endfor %}
</mwc-box>
<mwc-divider>
</mwc-divider>
<mwc-text-container>
  <mwc-typography variant="headline">
    <h2>Buttons</h2>
  </mwc-typography>
  {% for variant in button.variants %}
    {% for isDisabled in disabled %}
      {% for shape in button.shapes %}
        <mwc-typography variant="title" text-transform="capitalize">
          <h3>
            {{ variant }} {{ shape }}
            {% if isDisabled %}(disabled){% endif %}
          </h3>
        </mwc-typography>
        <mwc-box>
          {% for icon in icons %}
            {% for size in button.sizes %}
              <mwc-button size="{{ size }}"
                          variant="{{ variant }}"
                          shape="{{ shape }}"
                          {% if isDisabled %}disabled{% endif %}>
                {% if icon.leading %}
                  <mwc-material-symbol>
                    favorite
                  </mwc-material-symbol>
                {% endif %}
                Label
                {% if icon.trailing %}
                  <mwc-material-symbol>
                    favorite
                  </mwc-material-symbol>
                {% endif %}
              </mwc-button>
            {% endfor %}
          {% endfor %}
        </mwc-box>
      {% endfor %}
    {% endfor %}
  {% endfor %}
</mwc-text-container>
