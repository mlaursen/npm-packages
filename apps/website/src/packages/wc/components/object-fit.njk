---
layout: docs

eleventyNavigation:
  key: Object Fit
  parent: Home

page:
  title: Object Fit

images:
  - name: coffeeCup
    width: 200
    height: 300
  - name: laptop
    width: 300
    height: 200
  - name: sunset
    width: 300
    height: 300
  - name: trainStation
    width: 100
    height: 110
---

<mwc-card style="position: sticky;
                 top: 4rem;
                 z-index: 8;
                 --mwc-box-item-min-size: 10rem">
  <form style="width: 100%">
    <mwc-dialog-header>
      <mwc-dialog-title>
        Variant
      </mwc-dialog-title>
    </mwc-dialog-header>
    <mwc-radio-group aria-label="Object Fit">
      <mwc-box grid>
        {% for variant in objectFit.variants %}
          <mwc-typography variant="label" text-transform="capitalize">
            <label>
              <mwc-box padding="none" inline>
                <mwc-radio name="object-fit"
                           value="{{ variant }}"
                           required
                           {{ "checked" if variant === "contain" }}>
                </mwc-radio>
                {{ variant }}
              </mwc-box>
            </label>
          </mwc-typography>
        {% endfor %}
      </mwc-box>
    </mwc-radio-group>
  </form>
</mwc-card>
<mwc-typography variant="title" margin="top">
  <h3>With Picture</h3>
</mwc-typography>
<mwc-box grid align="stretch" full-width>
  {% for image in images %}
    <mwc-card align="center" justify="center">
      <mwc-object-fit>
        {% unsplash image.name, { width: image.width, height: image.height } %}
      </mwc-object-fit>
    </mwc-card>
  {% endfor %}
</mwc-box>
<mwc-divider>
</mwc-divider>
<mwc-typography variant="title" margin="top">
  <h3>Without Picture</h3>
</mwc-typography>
<mwc-box grid align="stretch" full-width>
  {% for image in images %}
    <mwc-card align="center" justify="center">
      <mwc-object-fit>
        {% unsplash image.name, { width: image.width, height: image.height, ignore: true } %}
      </mwc-object-fit>
    </mwc-card>
  {% endfor %}
</mwc-box>
<mwc-divider>
</mwc-divider>
<mwc-typography variant="title">
  <h3>Inline</h3>
</mwc-typography>
<mwc-card align="center" justify="center" style="width: 960px; height: 540px;">
  <mwc-object-fit inline>
    {% unsplash "lake", { width: 480, height: 270, ignore: true } %}
  </mwc-object-fit>
</mwc-card>
<mwc-card align="center"
          justify="center"
          style="width: 360px;
                 height: 800px;
                 margin-top: var(--mwc-spacing-extra-large)">
  <mwc-object-fit inline>
    {% unsplash "lake", { width: 480, height: 270, ignore: true } %}
  </mwc-object-fit>
</mwc-card>
<mwc-divider style="margin-block: var(--mwc-spacing-extra-large)">
</mwc-divider>
<mwc-card align="center" justify="center"style="width: 960px; height: 540px;">
  <mwc-object-fit>
    {% unsplash "lake", { width: 480, height: 270, ignore: true } %}
  </mwc-object-fit>
</mwc-card>
<mwc-card align="center"
          justify="center"
          style="width: 360px;
                 height: 800px;
                 margin-top: var(--mwc-spacing-extra-large)">
  <mwc-object-fit>
    {% unsplash "lake", { width: 480, height: 270, ignore: true } %}
  </mwc-object-fit>
</mwc-card>
{% js "defer" %}
{% include "scripts/wc/object-fit.js" %}
{% endjs %}
