---
layout: docs
eleventyNavigation:
  key: Tooltip
  parent: Home

page:
  title: Tooltip
---

<mwc-card style="position: sticky;
                 top: 4rem;
                 z-index: 8;
                 --mwc-box-item-min-size: 10rem">
  <form style="width: 100%">
    <mwc-dialog-header>
      <mwc-dialog-title>
        Settings
      </mwc-dialog-title>
    </mwc-dialog-header>
    <mwc-box grid>
      <mwc-typography variant="label">
        <label>
          <mwc-box padding="none">
            <mwc-checkbox name="arrow">
            </mwc-checkbox>
            Arrow
          </mwc-box>
        </label>
      </mwc-typography>
    </mwc-box>
    <mwc-box stacked align="start">
      <mwc-typography id="placement-title"variant="title" margin="none">
        <h3>Placement</h3>
      </mwc-typography>
      <mwc-radio-group aria-labelledby="placement-title">
        <mwc-box padding="none">
          {% for placement in tooltip.placements %}
            <mwc-typography>
              <label>
                <mwc-box padding="none" inline>
                  <mwc-radio name="placement"
                             value="{{ placement }}"
                             required
                             {{ "checked" if placement == "end-center" }}>
                  </mwc-radio>
                  {{ placement }}
                </mwc-box>
              </label>
            </mwc-typography>
          {% endfor %}
        </mwc-box>
      </mwc-radio-group>
    </mwc-box>
  </form>
</mwc-card>
<mwc-box style="height: 20rem" justify="center">
  <mwc-tooltip id="tooltip">
    <mwc-button slot="popover-target">
      Button
    </mwc-button>
    <div slot="tooltip">Hello, world!</div>
  </mwc-tooltip>
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/tooltip.js" %}
{% endjs %}
