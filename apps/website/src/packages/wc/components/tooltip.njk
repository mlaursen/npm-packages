---
layout: docs
eleventyNavigation:
  key: Tooltip
  parent: Home

page:
  title: Tooltip
---

<mwc-card style="position: sticky;
                 top: 4rem;
                 z-index: 8;
                 --mwc-box-item-min-size: 10rem">
  <form style="width: 100%">
    <mwc-dialog-header>
      <mwc-dialog-title>
        Settings
      </mwc-dialog-title>
    </mwc-dialog-header>
    <mwc-box grid>
      <mwc-typography variant="label">
        <label>
          <mwc-box padding="none">
            <mwc-checkbox name="arrow">
            </mwc-checkbox>
            Arrow
          </mwc-box>
        </label>
      </mwc-typography>
    </mwc-box>
  </form>
</mwc-card>
<mwc-typography variant="title" margin="top">
  <h3>Placements</h3>
</mwc-typography>
<mwc-box id="tooltips-playground" style="--mwc-box-gap: 6rem" stacked>
  {% for y in popover.verticalAnchors %}
    {% for x in popover.horizontalAnchors %}
      <mwc-tooltip anchor-x="{{ x }}" anchor-y="{{ y }}">
        <mwc-button slot="popover-target">
          {{ x }} - {{ y }}
        </mwc-button>
        <span slot="tooltip">Hello, world!</span>
      </mwc-tooltip>
    {% endfor %}
  {% endfor %}
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/tooltip.js" %}
{% endjs %}
