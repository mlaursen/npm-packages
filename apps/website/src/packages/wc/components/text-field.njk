---
layout: docs

eleventyNavigation:
  key: Text Field
  parent: Home

page:
  title: Text Field

types:
  - text
  - textarea

---

<div>
  <mwc-outlined-button id="toggle-grid" aria-pressed="false">
    Full Width Grid
  </mwc-outlined-button>
</div>
<mwc-box id="grid"
         grid="2"
         align="start"
         style="align-items: initial;
                display: inline-grid">
  {% for type in types %}
    {% for variant in textField.variants %}
      {% for shape in textField.shapes %}
        <mwc-box style="display: inline-flex;
                        align-items: initial"
                 padding="none"
                 stacked>
          <mwc-typography margin="top">
            <h3>{{ shape | capitalize }}</h3>
          </mwc-typography>
          {% set tagName = "mwc-" + variant + "-text-field" %}
          {% for state in textField.states %}
            <{{ tagName }} placeholder="Placeholder" {{ state if state != "normal" }} type="{{ type }}">
            <span slot="label">Label</span>
            </{{ tagName }}>
            <{{ tagName }} placeholder="Placeholder only" {{ state if state != "normal" }} type="{{ type }}">
            </{{ tagName }}>
            <{{ tagName }} {{ state if state != "normal" }} value="{{ "Hello, world!" }}" type="{{ type }}">
            <span slot="label">{{ variant | capitalize }} {{ state | capitalize if state != "normal" }}</span>
            </{{ tagName }}>
            <{{ tagName }} placeholder="Placeholder only" {{ state if state != "normal" }} value="{{ "Placeholder only with value" }}" type="{{ type }}">
            </{{ tagName }}>
            <mwc-divider>
            </mwc-divider>
          {% endfor %}
          <{{ tagName }} value="{{ "Hello, world!" }}">
          <span slot="label">This is a really long label that will cause issues!</span>
          </{{ tagName }}>
          {% if variant != textField.variants.at(-1) %}
            <mwc-divider>
            </mwc-divider>
          {% endif %}
        </mwc-box>
      {% endfor %}
    {% endfor %}
  {% endfor %}
</mwc-box>
{% js "defer" %}
const toggle = document.querySelector("#toggle-grid");
const grid = document.querySelector("#grid");
const selected = {
grid: true,
};
const unselected = {
grid: "2",
style: "align-items: initial; display: inline-grid",
}
toggle.addEventListener("click", () => {
const nextPressed = toggle.ariaPressed === "false";
toggle.ariaPressed = `${nextPressed}`
if (nextPressed) {
grid.removeAttribute("style");
grid.setAttribute("grid", "true");
} else {
grid.setAttribute("grid", "2");
grid.setAttribute("style", "align-items: initial; display: inline-grid");
}
});
{% endjs %}
