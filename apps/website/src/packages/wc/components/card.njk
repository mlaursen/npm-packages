---
layout: docs

eleventyNavigation:
  key: Card
  parent: Home

page:
  title: Card
---

<mwc-box stacked align="stretch" padding="none">
  {% for variant in card.variants %}
    <mwc-typography variant="headline" text-transform="capitalize">
      <h3>{{ variant }}</h3>
    </mwc-typography>
    <mwc-box grid align="stretch">
      {% for clickable in card.clickable %}
        {% for disabled in card.disabled %}
          {% if not disabled or clickable %}
            <mwc-card variant="{{ variant }}"
                      gap="none"
                      {{ "clickable" if clickable }}
                      {{ "disabled" if clickable and disabled}}>
              <img src="{{ card.image.src }}" alt="{{ card.image.alt }}" />
              <mwc-box stacked align="start">
                <mwc-typography variant="display" size="medium" margin="none">
                  <h3>{% if disabled %}Disabled{% elseif clickable %}Clickable{% else %}Headline {% endif %}</h3>
                </mwc-typography>
                <mwc-typography variant="title" margin="none">
                  <h4>Subhead</h4>
                </mwc-typography>
                <mwc-typography margin="none">
                  <p>Explain more about the topic shown in the medium display and subhead through supporting text here.</p>
                </mwc-typography>
              </mwc-box>
            </mwc-card>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </mwc-box>
  {% endfor %}
</mwc-box>
