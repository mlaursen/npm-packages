---
layout: docs

eleventyNavigation:
  key: Card
  parent: Home

page:
  title: Card

components:
  - title: Non-interactive
  - title: Clickable
    clickable: true
  - title: Disabled
    clickable: true
    disabled: true
  - title: Link
    href: '#'
---

<mwc-box stacked align="stretch" padding="none">
  {% for variant in card.variants %}
    <mwc-typography variant="headline" text-transform="capitalize" margin="top">
      <h3>{{ variant }}</h3>
    </mwc-typography>
    <mwc-box grid align="stretch" style="--mwc-box-item-min-size: 16rem">
      {% for component in components %}
        <mwc-card variant="{{ variant }}"
                  {{ "clickable" if component.clickable }}
                  {{ "disabled" if component.disabled }}
                  {%- if component.href %} href="{{ component.href }}" {% endif %}>
          <mwc-box stacked align="start">
            <mwc-typography variant="display" size="medium" margin="none">
              <h3>{{ component.title }}</h3>
            </mwc-typography>
            <mwc-typography variant="title" margin="none">
              <h4>Subhead</h4>
            </mwc-typography>
            <mwc-typography margin="none">
              <p>Explain more about the topic shown in the medium display and subhead through supporting text here.</p>
            </mwc-typography>
          </mwc-box>
        </mwc-card>
      {% endfor %}
    </mwc-box>
  {% endfor %}
</mwc-box>
<mwc-divider>
</mwc-divider>
<mwc-typography variant="display">
  <h2>Drag and Drop Example</h2>
</mwc-typography>
<mwc-box id="dnd-area">
  {% for i in [1, 2, 3, 4] %}
    <mwc-card draggable="true">
      <mwc-box>
        <mwc-typography variant="title">
          <h4>Drag Me {{ i }}</h4>
        </mwc-typography>
      </mwc-box>
    </mwc-card>
  {% endfor %}
</mwc-box>
{% js "defer" %}
{% include "scripts/wc/card.js" %}
{% endjs %}
