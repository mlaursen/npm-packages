<mwc-typography>
  <p id="content">This should be copied!</p>
</mwc-typography>
<mwc-copy-to-clipboard value="Text to copy">
</mwc-copy-to-clipboard>
<mwc-copy-to-clipboard value="Text to copy" disabled>
</mwc-copy-to-clipboard>
<mwc-copy-to-clipboard id="async-event">
</mwc-copy-to-clipboard>
<mwc-copy-to-clipboard value="Text to copy">
  <mwc-button slot="button">
    Custom button
  </mwc-button>
</mwc-copy-to-clipboard>
<mwc-copy-to-clipboard id="copy-image">
  <mwc-button slot="button">
    Copy Image
  </mwc-button>
</mwc-copy-to-clipboard>
<mwc-copy-to-clipboard value="This is overriding everything">
  <mwc-typography slot="override" variant="title">
    <p>This is overriding everything</p>
  </mwc-typography>
</mwc-copy-to-clipboard>
<mwc-card class="paste-target">
  <mwc-box>
    <mwc-typography variant="title">
      <h3>Test Paste Here</h3>
    </mwc-typography>
  </mwc-box>
  <mwc-box class="paste-output" align="start">
  </mwc-box>
  <mwc-box justify="end">
    <mwc-button id="clear-paste" variant="outlined" color="tertiary">
      Clear
    </mwc-button>
  </mwc-box>
</mwc-card>
{% js "defer" %}
{% include "scripts/wc/copy-to-clipboard.js" %}
{% endjs %}
{% css "local" %}
{% include "css/wc/copy-to-clipboard.css" %}
{% endcss %}
