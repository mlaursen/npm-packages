---
layout: base
---

<main>
  <mwc-text-container>
    <mwc-typography variant="display">
      <h1>Hello,</h1>
    </mwc-typography>
    <mwc-typography variant="headline">
      <p>
        This page is empty since I haven't really made this site yet. You
        can check out my
        <mwc-link href="https://github.com/mlaursen">
          GitHub
        </mwc-link>
        for some more information about projects I work on.
      </p>
    </mwc-typography>
  </mwc-text-container>
  {% if meta.showHomeNavigation %}
    <mwc-text-container>
      <mwc-typography variant="display" size="small">
        <h2>Navigation</h2>
      </mwc-typography>
      <mwc-typography variant="headline" size="small">
        <h3>@mlaursen/wc</h3>
      </mwc-typography>
      <mwc-typography>
        {{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}
      </mwc-typography>
    </mwc-text-container>
  {% endif %}
</main>
