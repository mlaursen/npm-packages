{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#types": "./types.ts"
  },
  "scripts": {
    "node-run": "node --experimental-strip-types",
    "test-clean-generated": "git clean -ndX src",
    "clean-generated": "git clean -fdXq src",
    "clean-site": "rm -rf _site",
    "clean-dist": "concurrently 'pnpm clean-site' 'pnpm clean-generated'",
    "clean-cache": "rm -rf .turbo node_modules",
    "clean": "pnpm clean-dist; pnpm clean-cache",
    "create-favicons": "pnpm node-run scripts/create-favicons.ts",
    "update-material-symbols": "pnpm node-run scripts/update-material-symbols.ts",
    "format": "oxfmt",
    "check-format": "pnpm format --check",
    "lint": "oxlint .",
    "lint-fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck-watch": "tsc --noEmit --watch",
    "test-playwright": "pnpm playwright test",
    "test-playwright-ui": "pnpm test-playwright --ui",
    "test-report": "pnpm playwright show-report",
    "11ty": "pnpm exec eleventy",
    "build": "cross-env NODE_ENV=production pnpm 11ty",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 pnpm build",
    "build-debug": "cross-env DEBUG=Eleventy* pnpm build",
    "build-benchmark": "cross-env DEBUG=Eleventy:Benchmark* pnpm build",
    "dev": "cross-env NODE_ENV=development pnpm 11ty --serve",
    "dev-debug": "cross-env NODE_ENV=development DEBUG=Eleventy* pnpm 11ty --serve --quiet",
    "dev-ghpages": "pnpm dev-11ty --pathprefix=/npm-packages/wc/ --serve --quiet",
    "start": "python3 -m http.server 8080 -d _site"
  },
  "dependencies": {
    "@tanstack/lit-virtual": "^3.15.3",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "11ty.ts": "^0.0.7",
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@lit-labs/eleventy-plugin-lit": "^1.0.6",
    "@mlaursen/node-utils": "workspace:*",
    "@mlaursen/oxlint-config": "workspace:*",
    "@mlaursen/scss": "workspace:*",
    "@mlaursen/utils": "workspace:*",
    "@mlaursen/wc": "workspace:*",
    "@open-wc/lit-helpers": "^0.7.0",
    "@playwright/test": "^1.65.0",
    "@shikijs/markdown-it": "^4.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.6",
    "browserslist": "^4.29.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "glob": "^14.0.5",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.32.0",
    "lit": "^3.3.3",
    "markdown-it": "^15.0.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sass-embedded": "^1.108.2",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "slugify": "^1.6.9",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
